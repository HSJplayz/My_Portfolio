# ── Required ─────────────────────────────────────────────
# Google Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Resend API key from https://resend.com/api-keys
RESEND_API_KEY=

# ── Optional ─────────────────────────────────────────────
# Where contact-form emails should be delivered (defaults to hrushijagtap333@gmail.com)
# RESEND_TO=you@example.com
# Verified sender shown in the "From" field
# RESEND_FROM="My Portfolio <onboarding@resend.dev>"

# ── Chatbot learning track ───────────────────────────────
# Switch providers without touching code:
#   LLM_PROVIDER=google   → @ai-sdk/google (default)
#   LLM_PROVIDER=groq     → npm i @ai-sdk/groq (adds GROQ_API_KEY + GROQ_MODEL)
#   LLM_PROVIDER=ollama   → local learning (adds OLLAMA_MODEL)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-3.5-flash
